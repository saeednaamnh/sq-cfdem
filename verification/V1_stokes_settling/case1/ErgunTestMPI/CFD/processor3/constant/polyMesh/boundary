FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

5
(
    inlet
    {
        type            patch;
        nFaces          48;
        startFace       3120;
    }
    outlet
    {
        type            patch;
        nFaces          48;
        startFace       3168;
    }
    wall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          192;
        startFace       3216;
    }
    procBoundary3to1
    {
        type            processor;
        inGroups        1(processor);
        nFaces          192;
        startFace       3408;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        3;
        neighbProcNo    1;
    }
    procBoundary3to2
    {
        type            processor;
        inGroups        1(processor);
        nFaces          192;
        startFace       3600;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        3;
        neighbProcNo    2;
    }
)

