FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.16";
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 10;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    wall
    {
        type            zeroGradient;
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 10;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 10;
    }
}


