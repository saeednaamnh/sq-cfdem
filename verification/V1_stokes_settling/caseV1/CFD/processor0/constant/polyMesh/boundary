FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

5
(
    inlet
    {
        type            patch;
        nFaces          1;
        startFace       5;
    }
    outlet
    {
        type            patch;
        nFaces          1;
        startFace       6;
    }
    wall
    {
        type            wall;
        inGroups        1(wall);
        nFaces          12;
        startFace       7;
    }
    procBoundary0to1
    {
        type            processor;
        inGroups        1(processor);
        nFaces          6;
        startFace       19;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        0;
        neighbProcNo    1;
    }
    procBoundary0to2
    {
        type            processor;
        inGroups        1(processor);
        nFaces          6;
        startFace       25;
        matchTolerance  0.0001;
        transform       unknown;
        myProcNo        0;
        neighbProcNo    2;
    }
)

