# ============================================================================
# PLACEMENT: prolate_3 (c/a = 3.0)
# Semi-axes: a=0.2371, b=0.2371, c=0.7114
# ============================================================================

variable    a           equal   0.2371
variable    b           equal   0.2371
variable    c           equal   0.7114
variable    N_particles equal   3795
variable    box_x       equal   15
variable    box_y       equal   10
variable    box_z       equal   10
variable    rho_p       equal   1.0
variable    e_n         equal   0.98
variable    kn_val      equal   200000.0
variable    mu_friction equal   0.0
variable    lattice_sp  equal   0.5

# --- Derived ---
variable    diameter    equal   2*${a}
variable    V_particle  equal   (4.0/3.0)*PI*${a}*${b}*${c}
variable    m_particle  equal   ${rho_p}*${V_particle}
variable    m_ij        equal   ${m_particle}/2.0
variable    eta0        equal   sqrt(${kn_val}/${m_ij}*(ln(${e_n}))^2/(PI^2+(ln(${e_n}))^2))
variable    damping_n   equal   2.0*${m_ij}*${eta0}
variable    omega0      equal   sqrt(${kn_val}/${m_ij}-${eta0}^2)
variable    t_contact   equal   PI/${omega0}
variable    dt          equal   ${t_contact}/50.0
variable    damp_sc     equal   ${damping_n}/${m_ij}

atom_style      superquadric
atom_modify     map array
boundary        p p f
newton          off
communicate     multi cutoff 0.01 vel yes
processors      * * 1
units           si
timestep        ${dt}

neighbor        0.15 bin
neigh_modify    delay 0 every 1 check yes

region          box_reg block 0 ${box_x} 0 ${box_y} 0 ${box_z} units box
create_box      3 box_reg

# Material properties
fix  p_E  all property/global youngsModulus peratomtype 6e6 6e6 6e6
fix  p_nu all property/global poissonsRatio peratomtype 0.3 0.3 0.3
fix  p_e  all property/global coefficientRestitution peratomtypepair 3 ${e_n} ${e_n} ${e_n} ${e_n} ${e_n} ${e_n} ${e_n} ${e_n} ${e_n}
fix  p_mu all property/global coefficientFriction peratomtypepair 3 ${mu_friction} ${mu_friction} ${mu_friction} ${mu_friction} ${mu_friction} ${mu_friction} ${mu_friction} ${mu_friction} ${mu_friction}
fix  p_cv all property/global characteristicVelocity scalar 2.0
fix  p_kn all property/global kn peratomtypepair 3 ${kn_val} ${kn_val} ${kn_val} ${kn_val} ${kn_val} ${kn_val} ${kn_val} ${kn_val} ${kn_val}
fix  p_gn all property/global gamman peratomtypepair 3 ${damp_sc} ${damp_sc} ${damp_sc} ${damp_sc} ${damp_sc} ${damp_sc} ${damp_sc} ${damp_sc} ${damp_sc}
fix  p_kt all property/global kt peratomtypepair 3 0 0 0 0 0 0 0 0 0
fix  p_gt all property/global gammat peratomtypepair 3 0 0 0 0 0 0 0 0 0

pair_style      gran model hooke tangential history surface superquadric
pair_coeff      * *

# --- Lower wall ---
lattice         sc ${lattice_sp} origin 0 0 0
region          lower_wall_reg block 0 EDGE 0 EDGE 0 0.1 units box
create_atoms    1 region lower_wall_reg
group           lowerGroup region lower_wall_reg
set             group lowerGroup type 1
set             group lowerGroup quat 0 1 0 90
lattice         none 1

# --- Upper wall ---
lattice         sc ${lattice_sp} origin 0 0 0.45
region          upper_wall_reg block 0 EDGE 0 EDGE 9.7 EDGE units box
create_atoms    2 region upper_wall_reg
group           upperGroup region upper_wall_reg
set             group upperGroup type 1
set             group upperGroup quat 0 1 0 90
lattice         none 1

group           boundary union upperGroup lowerGroup

# --- Insert free particles ---
variable        z_lo equal xcm(lowerGroup,z)+${diameter}
variable        z_hi equal xcm(upperGroup,z)-${diameter}
region          insert_reg block 0 EDGE 0 EDGE ${z_lo} ${z_hi} units box
group           layerGroup region insert_reg

fix  pt1 all particletemplate/superquadric 15485863 atom_type 1 density constant ${rho_p} shape constant ${a} ${b} ${c} blockiness constant 2 2
fix  pd1 all particledistribution/discrete 15485867 1 pt1 1.0
fix  ins layerGroup insert/pack seed 32452843 distributiontemplate pd1 vel constant 0 0 -0.5 insert_every 2000 overlapcheck yes all_in yes particles_in_region ${N_particles} region insert_reg

fix  integrate layerGroup nve/superquadric integration_scheme 1
fix  grav all gravity 9.81 vector 0 0 -1

variable H_gap  equal xcm(upperGroup,z)-xcm(lowerGroup,z)-${diameter}
variable vfrac  equal count(layerGroup)*${V_particle}/(lx*ly*v_H_gap)

thermo_style    custom step atoms ke vol
thermo          500

shell mkdir -p restarts
shell mkdir -p results/placement

dump d_place all custom 5000 results/placement/dump.place id type mass x y z vx vy vz omegax omegay omegaz shapex shapey shapez quat1 quat2 quat3 quat4 blockiness1 blockiness2 tqx tqy tqz radius

print "=== SETTLING ==="
run  500000 upto

unfix ins
unfix grav

print "=== RELAXING ==="
run  80000

print "=== PLACEMENT DONE ==="
print "  Shape: (${a}, ${b}, ${c}), c/a = 3.0"
print "  Volume fraction: ${vfrac}"
print "  Gap height: ${H_gap}"

write_restart restarts/restart_placed.liggghts
