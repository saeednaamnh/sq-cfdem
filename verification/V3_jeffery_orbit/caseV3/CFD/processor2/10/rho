FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "10";
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 10;

boundaryField
{
    cycXa
    {
        type            cyclic;
    }
    cycXb
    {
        type            cyclic;
    }
    cycYa
    {
        type            cyclic;
    }
    cycYb
    {
        type            cyclic;
    }
    wallBottom
    {
        type            zeroGradient;
    }
    wallTop
    {
        type            zeroGradient;
    }
    procBoundary2to0
    {
        type            processor;
        value           uniform 10;
    }
    procBoundary2to0throughcycYb
    {
        type            processorCyclic;
        value           uniform 10;
    }
    procBoundary2to3
    {
        type            processor;
        value           uniform 10;
    }
    procBoundary2to3throughcycXa
    {
        type            processorCyclic;
        value           uniform 10;
    }
}


