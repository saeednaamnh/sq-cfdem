        startFace       144;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  cycXb;
    }
    cycXb
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          16;
        startFace       160;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  cycXa;
    }
    cycYa
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          16;
        startFace       176;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  cycYb;
    }
    cycYb
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          16;
        startFace       192;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  cycYa;
    }
    wallBottom
    {
        type            wall;
        inGroups        1(wall);
        nFaces          16;
        startFace       208;
    }
    wallTop
    {
        type            wall;
        inGroups        1(wall);
        nFaces          16;
